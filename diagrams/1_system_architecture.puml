@startuml
title IoT IDS System Architecture

skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 2

box "WiFi Network" #FFE8E8
    participant "ESP32\n+ AM2320\n192.168.100.25" as ESP
    participant "Attacker\nLaptop\n192.168.100.91" as ATK
end box

box "Raspberry Pi 5 — 192.168.100.24" #E8F0FF
    participant "Mosquitto\nBroker\nPort 1883" as BROKER
    participant "Thread 1\nPCAP\nCapture" as T1
    participant "Thread 2\nMQTT\nSubscriber" as T2
    participant "Thread 3\nIDS Engine\n+ Voting" as T3
    participant "LightGBM\nw=0.40" as LGBM
    participant "Random\nForest\nw=0.20" as RF
    participant "Isolation\nForest\nw=0.40" as IF
    participant "ids_logger\n.py" as LOGGER
end box

ESP -> BROKER : MQTT publish\niot/sensors/environmental\nevery 5 seconds
ATK -> BROKER : TCP/MQTT attacks\n7 attack types\nport 1883

BROKER -> T2 : subscribe #\nall topics
BROKER -> T1 : TCP packets\ncaptured via pyshark

T1 -> T1 : append to\npcap_buffer\ndeque(10000)
T2 -> T2 : compute\n13 MQTT features\nFeatureState

T2 -> T1 : get_pcap_features\n(t-5s, t)
T1 --> T2 : 4 PCAP features\npcap_ipt_log\ntcp_reconnect_rate

T2 -> T3 : message dict\n17 features total

T3 -> LGBM : predict()
LGBM --> T3 : label + conf\nvote 0.40

T3 -> RF : predict()
RF --> T3 : is_attack\nvote 0.20

T3 -> IF : predict()
IF --> T3 : is_attack\nif_score\nvote 0.40

T3 -> T3 : weighted vote\n0.40+0.20+0.40\nscore >= 0.50?

T3 -> BROKER : publish\nids/alerts
BROKER -> LOGGER : ids/alerts\nreceived
LOGGER -> LOGGER : write to\nids_predictions.csv

@enduml