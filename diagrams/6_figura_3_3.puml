@startuml figura_3_3_architecture
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam shadowing false

skinparam rectangle {
  BorderColor #666666
  FontColor #333333
}

title IDS Three-Layer Architecture

package "Layer 1 — Capture" #d5e8d4 {
  rectangle "Thread 1\nPCAP Capture\n(PyShark / TShark, port 1883)" as T1 #ffffff
  rectangle "Thread 2\nMQTT Subscriber\n(Paho-MQTT, wildcard #)" as T2 #ffffff
}

package "Layer 2 — Feature Engineering" #dae8fc {
  rectangle "4 PCAP features\n(tcp_reconnect_rate,\npcap_ipt_log, etc.)" as F1 #ffffff
  rectangle "13 MQTT features\n(iat_log, json_field_count,\nseq_gap_clipped, etc.)" as F2 #ffffff
}

package "Layer 3 — Detection (Thread 3)" #fff2cc {
  rectangle "LightGBM\nMulticlass\nweight=0.40" as M1 #ffffff
  rectangle "Random Forest\nBinary\nweight=0.20" as M2 #ffffff
  rectangle "Isolation Forest\nUnsupervised\nweight=0.40" as M3 #ffffff
}

rectangle "ALERT\nids/alerts topic" as ALERT #f8cecc

T1 --> F1
T2 --> F2
F1 --> M1
F1 --> M2
F1 --> M3
F2 --> M1
F2 --> M2
F2 --> M3
M1 --> ALERT
M2 --> ALERT
M3 --> ALERT

note bottom of T1
  Interface 'any' captures
  both WiFi and loopback
  (127.0.0.1)
end note

note bottom of M3
  Trained on legitimate
  traffic only
end note

@enduml