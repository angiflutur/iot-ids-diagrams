@startuml
title Feature Engineering Pipeline — 17 Network-Independent Features

skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam SequenceGroupBackgroundColor #F0F8FF

participant "MQTT\nMessage\n(raw)" as MQTT #FFE0E0
participant "FeatureState\nClass" as FS #E0F0FF
participant "PCAP\nBuffer\n(last 5s)" as PCAP #E0FFE0
participant "Feature\nVector\n17D" as OUT #FFFFC0
participant "RobustScaler\n+ ML Models" as ML #FFE0C0

MQTT -> FS : topic, payload\ntimestamp, sequence

group Timing Features (2)
    FS -> FS : iat_log = log(1+IAT)\nDoS=0.027 vs Legit=1.79
    FS -> FS : burstiness = std/mean IAT\nwindow=10 messages
end

group Protocol Features (3)
    FS -> FS : json_field_count\nMITM=9.27 vs Legit=6.97
    FS -> FS : json_valid [BIN]\nMalformed JSON = 0
    FS -> FS : errors_flag [BIN]\nerrors > 0 = Malformed
end

group Topic Features (2)
    FS -> FS : topic_is_known [BIN]\nInjection = 0
    FS -> FS : topic_depth\nnumber of slashes
end

group Sensor Delta Features (4)
    FS -> FS : delta_temp_log = log(1+|delta_temp|)\nSpoofing=26.1 vs Legit=0.24
    FS -> FS : delta_hum_log = log(1+|delta_hum|)\nhumidity clipped to [-10, 200]
    FS -> FS : temp_rolling_std\nwindow=5 messages
    FS -> FS : hum_rolling_std\nwindow=5 messages
end

group Sequence Features (2)
    FS -> FS : seq_gap_clipped = clip(500)\nMITM=71.7 vs Normal=0
    FS -> FS : seq_backwards [BIN]\nreplay attack = 1
end

FS -> OUT : 13 MQTT features

PCAP -> PCAP : get_pcap_features\n(window_start, window_end)

group PCAP Features (4) — Network Independent
    PCAP -> PCAP : pcap_ipt_log = log(1+median_IPT)\nBF=0.001s vs Legit=2.37s
    PCAP -> PCAP : pcap_pkt_size_cv = std/mean length\nBF=0.35 vs Legit=1.01
    PCAP -> PCAP : pcap_syn_ratio = P(length < 60B)\nBF=0.89 vs Legit=0.50
    PCAP -> PCAP : tcp_reconnect_rate = unique_ports/5s\nBF=0.95 vs Legit=0.25\nNEW — Brute Force detector
end

PCAP -> OUT : 4 PCAP features

OUT -> ML : 17 features assembled
ML -> ML : RobustScaler.transform()\n13 numeric features only\n4 binary unchanged
ML -> ML : predict() x3 models\nweighted vote 0.40+0.20+0.40

note over PCAP
  tcp_reconnect_rate counts
  unique source ports != 1883
  divided by window (5s).
  Network-independent: works
  on any WiFi/hotspot topology.
end note

@enduml